{
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Relative URL of the independent preset Draft-07 JSON Schema.",
      "type": "string",
      "minLength": 1
    },
    "id": {
      "description": "Stable preset or shared parameter ID; never a runtime participant ID.",
      "type": "string",
      "minLength": 1
    },
    "order": {
      "description": "Display order; the preset ID breaks ties deterministically.",
      "type": "number"
    },
    "characterId": {
      "description": "Canonical character identity from the normalized game snapshot.",
      "type": "string",
      "minLength": 1
    },
    "i18n": {
      "description": "Localization keys resolved by the UI or compiler.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Participant name or preset display-name localization key, according to context.",
          "type": "string",
          "minLength": 1
        },
        "description": {
          "description": "Preset description localization key.",
          "type": "string",
          "minLength": 1
        },
        "unavailable": {
          "description": "Map semantic issue codes to existing localized explanations.",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["name", "description"],
      "additionalProperties": false
    },
    "icon": {
      "description": "Registered asset key or normalized character portrait reference.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "characterId": {
              "description": "Canonical character identity from the normalized game snapshot.",
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["characterId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "assetKey": {
              "description": "assetKey",
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["assetKey"],
          "additionalProperties": false
        }
      ]
    },
    "interaction": {
      "description": "draft prefills one editable operation; batch atomically applies the whole compiled document.",
      "enum": ["draft", "batch"]
    },
    "startOnly": {
      "description": "Restrict this preset to the battle-start insertion window.",
      "type": "boolean"
    },
    "snapshots": {
      "description": "Named immutable participant ID sets captured once from the insertion preview.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "target": {
            "description": "Semantic target resolved using engine eligibility at the actual insertion point.",
            "enum": ["allies", "enemies"]
          },
          "operation": {
            "description": "Engine operation used to determine snapshot eligibility.",
            "const": "depart"
          }
        },
        "required": ["target", "operation"],
        "additionalProperties": false
      }
    },
    "previews": {
      "description": "Localized read-only summaries derived from the shared inputs.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "description": "Existing localization key in both zh-CN.json and en.json.",
            "type": "string",
            "minLength": 1
          },
          "params": {
            "description": "Named localization arguments; names must match both message catalogs.",
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/value"
            }
          }
        },
        "required": ["key", "params"],
        "additionalProperties": false
      }
    },
    "operations": {
      "description": "Operations in execution order, at most 128 including nested triggers.",
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/definitions/operation"
      }
    },
    "selfPresence": {
      "description": "Required self presence at insertion; default any. Requires characterId. Each operation still checks its own target eligibility.",
      "enum": ["present", "departed", "any"]
    }
  },
  "required": ["id", "order", "i18n", "interaction", "operations"],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
