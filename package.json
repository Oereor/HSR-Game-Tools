{
  "name": "hsr-game-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "type-check": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "vite build",
    "update:game-data": "node --import tsx scripts/update-game-data.ts",
    "validate:game-data": "node --import tsx scripts/validate-game-data.ts",
    "bench:engine": "node --import tsx scripts/benchmark-engine.ts"
  },
  "dependencies": {
    "vue": "3.5.43",
    "vue-router": "4.6.4",
    "vue-i18n": "11.4.14"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/tsconfig": "0.9.1",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/eslint-config-prettier": "10.2.0",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vue-tsc": "3.3.13",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "sharp": "0.35.3",
    "tsx": "4.23.15"
  }
}
